{
  "name": "@bex-co/muse-code-acp",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.6.1",
  "description": "An ACP-compatible coding agent powered by Muse Code (unofficial adapter for Meta's muse CLI)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bex-co/muse-code-acp.git"
  },
  "homepage": "https://github.com/bex-co/muse-code-acp#readme",
  "bugs": {
    "url": "https://github.com/bex-co/muse-code-acp/issues"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "bin": {
    "muse-code-acp": "dist/index.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./*": "./*"
  },
  "files": [
    "dist/",
    "!dist/tests/",
    "docs/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "build:standalone": "node scripts/build-standalone.mjs",
    "test:standalone": "node scripts/standalone-smoke.mjs",
    "start": "node dist/index.js",
    "dev": "npm run build && npm run start",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "test": "vitest",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run",
    "test:run": "npm run build && vitest run",
    "test:unit": "vitest run --exclude 'src/tests/**/*-live.test.ts' --exclude 'src/tests/real-provider.integration.test.ts'",
    "test:muse-loopback": "vitest run src/tests/startup-live.test.ts src/tests/stored-output-live.test.ts src/tests/session-commands-live.test.ts src/tests/async-tasks-live.test.ts src/tests/failure-live.test.ts src/tests/progress-live.test.ts src/tests/settings-live.test.ts src/tests/safety-live.test.ts src/tests/muse-sdk-approval-live.test.ts src/tests/muse-sdk-multistage-live.test.ts src/tests/acp-restart-live.test.ts src/tests/muse-sdk-live.test.ts src/tests/mcp-http-live.test.ts src/tests/goal-live.test.ts src/tests/workflows-live.test.ts src/tests/session-fork-live.test.ts src/tests/file-change-live.test.ts src/tests/session-discovery-live.test.ts",
    "test:pack-smoke": "node scripts/pack-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "muse",
    "muse-code",
    "acp",
    "agent",
    "meta",
    "typescript",
    "code"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@muse-code/sdk": "1.3.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.2.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
